class Kiosk
  def initialize
    unless DRStats.trader?
      DRC.message('**EXIT: Must be a Trader with the Prosperity in Absentia spell to run this!**')
      exit
    end

    @settings = get_settings
    @town_data = get_data('town')
    @kiosk_settings = @settings.kiosk_settings
    @debug = @kiosk_settings['debug']
    @kiosk_room = @kiosk_settings['cast_room']
    @kiosk_noun = @kiosk_settings['kiosk_noun'] || "kiosk" # Kiosks, including the noun, can be altered
    @my_kiosk = nil # ordinal + noun
    @tessera = @settings.tessera_noun
    Flags.add('kiosk-desc', /, an? (.+?) unfolds from nothingness|You gesture at an? (.+?), which responds by briefly undulating|You sense your Properity in Abstentia spell within an? (.+), which/) # Watch for the long kiosk name, which is revealed on PRIA casts

    echo @kiosk_settings.to_yaml if @debug

    create_kiosk
    report = gather_report
    refill_kiosk(report['on_hand_amount'])
    withdraw_kiosk(report['pouch_amount'], report['bundle_amount'])

    DRCI.put_away_item?(@tessera)
  end

  # Rooms can have multiple kiosks. Kiosks can only be interacted with via ordinal + noun.
  # As kiosks are created and destroyed, our kiosk's ordinal can change.
  # The room description (DRRoom.room_objs) contains non-unique long names (eg, "heptagonally symmetrical crystalline kiosk"). Our kiosk's long name is revealed on cast.
  # We reduce the RT-intensive search for our kiosk by limiting it to only the kiosks matching our long name.
  # If the kiosk Item ID is ever revealed in the future, this can be massively simplified.
  def identify_my_kiosk(force = false)
    if @debug
      echo "identify_my_kiosk: #{force}"
      echo "SessionVars.kiosk_name: #{SessionVars.kiosk_name}"
      echo "my_kiosk: #{@my_kiosk}"
    end

    return @my_kiosk if @my_kiosk && !force
    create_kiosk unless DRSpells.active_spells['Prosperity in Absentia']

    DRCT.walk_to(@kiosk_room)
    if Flags['kiosk-desc']
      match = Flags['kiosk-desc']
      SessionVars.kiosk_name = match[1] || match[2] || match[3]
      Flags.reset('kiosk-desc')
    end

    kiosk_search = SessionVars.kiosk_name || @kiosk_noun
    # "spindly and acicular crystalline kiosk" gets mangled by the room_obj parser.
    # Rather than fix that, we'll drop everything to the left of the "and"
    kiosk_search = kiosk_search.split(' and ', 2).last

    echo "kiosk_search: #{kiosk_search}" if @debug
    echo "room_objs: #{DRRoom.room_objs.inspect}" if @debug

    kiosk_indices = DRRoom.room_objs.each_index.select { |i| DRRoom.room_objs[i].include?(@kiosk_noun) }

    kiosks = kiosk_indices.each_with_index
                          .select { |room_i, _ord_i| DRRoom.room_objs[room_i] == kiosk_search }
                          .map { |_room_i, ord_i| "#{$ORDINALS[ord_i]} #{@kiosk_noun}" }

    echo "kiosks in room: #{kiosks}" if @debug
    return kiosks[0] if kiosks.size == 1

    for kiosk in kiosks
      study = DRC.bput("study #{kiosk}", 'As you examine your ', 'As you are not the owner of')
      return kiosk if study =~ /As you examine your/
    end
  end

  def create_kiosk
    if @debug
      echo "create_kiosk"
      echo "PRIA: #{DRSpells.active_spells['Prosperity in Absentia']}"
      echo "waggle: #{@settings.waggle_sets['kiosk']}"
    end

    return unless DRSpells.active_spells['Prosperity in Absentia'].nil? ||
                  DRSpells.active_spells['Prosperity in Absentia'].to_i <= @settings.waggle_sets['kiosk']['Prosperity in Absentia']['recast']

    DRCT.walk_to(@kiosk_room)
    DRCI.get_item_if_not_held?(@tessera)

    cast_type = DRSpells.active_spells['Prosperity in Absentia'].nil? ? 'new' : 'refresh'
    Flags.reset('kiosk-desc')
    echo "cast_type: #{cast_type}" if @debug

    DRCA.do_buffs(@settings, 'kiosk')
    pause 0.5
    fput('perceive self')
    pause 0.5

    if DRSpells.active_spells['Prosperity in Absentia'].nil?
      DRC.message("Unable to cast Prosperity in Absentia.")
      exit
    end

    if @kiosk_settings['markup']
      kiosk_markup = 0
      @my_kiosk = identify_my_kiosk

      unless @my_kiosk
        DRC.message("Unable to identify my kiosk.")
        exit
      end

      if cast_type == 'refresh'
        result = DRC.bput("study #{@my_kiosk}", /The markup is set to -?\d+%/)
        kiosk_markup = result.match(/set to (?<kiosk_markup>-?\d+)%/)[:kiosk_markup].to_f
      end

      target_markup = @kiosk_settings['markup'].to_f
      target_markup *= 100 if target_markup.between?(-1, 1) # If the player provided .6 instead of 60, convert it
      target_markup = (target_markup / 5.0).floor * 5 # Round down to a multiple of 5
      target_markup = target_markup.clamp(-10, 80) # Must be between -10 and 80

      until kiosk_markup == target_markup
        if kiosk_markup < target_markup
          result = DRC.bput("pull #{@my_kiosk}", /set to -?\d+%/, 'As you are not the owner of a')
        else
          result = DRC.bput("push #{@my_kiosk}", /set to -?\d+%/, 'As you are not the owner of a')
        end

        if result == "As you are not the owner of a"
          @my_kiosk = identify_my_kiosk(true)
          return create_kiosk
        end

        kiosk_markup = result.match(/set to (?<kiosk_markup>-?\d+)%/)[:kiosk_markup].to_i
      end
    end
  end

  def parse_coins(line)
    echo "parse_coins: #{line}" if @debug
    return 0 if line.nil? || line.include?('No ')

    line.scan(/([\d,]+) (platinum|gold|silver|bronze|copper)/i).sum do |amount, denom|
      DRCM.convert_to_copper(amount.delete(','), denom)
    end
  end

  def gather_report
    echo "gather_report" if @debug
    DRCI.get_item_if_not_held?(@tessera)

    waitrt?
    report = Lich::Util.issue_command(
      "ask my #{@tessera} about report",
      /current asset holdings are:$/,
      /The floating data fades with a friendly chime/,
      usexml: false
    )

    if report.empty?
      create_kiosk
      return gather_report
    end

    echo "report: #{report.inspect}" if @debug

    on_hand_line = report.find { |line| line.include?('Kronars on hand') }
    pouch_line = report.find { |line| line.include?('Kronars in pouches') }
    bundle_line = report.find { |line| line.include?('Kronars in bundles') }

    total_on_hand = parse_coins(on_hand_line)
    total_pouches = parse_coins(pouch_line)
    total_bundles = parse_coins(bundle_line)

    echo "parsed: on_hand=#{total_on_hand}, pouches=#{total_pouches}, bundles=#{total_bundles}" if @debug

    return {
      'on_hand_amount' => total_on_hand,
      'pouch_amount'   => total_pouches,
      'bundle_amount'  => total_bundles
    }
  end

  # Basically DRCT.sort_destinations, but forcing @kiosk_room instead of current
  def sort_destinations_from_kiosk(target_list)
    target_list = target_list.collect(&:to_i)
    _previous, shortest_distances = Map.dijkstra(@kiosk_room)
    # Pathfinding failed; hand back what was asked for rather than nothing.
    return target_list if shortest_distances.nil?

    target_list.delete_if { |room_num| shortest_distances[room_num].nil? && room_num != Room.current.id }
    # The current room is kept above even without a distance, so sort on a
    # fallback rather than handing nil to the comparator. dijkstra seeds the
    # source at 0, so this is defensive rather than a live case.
    target_list.sort_by { |room_num| shortest_distances[room_num] || Float::INFINITY }
  end

  def find_closest_bank
    echo "find_closest_bank" if @debug
    towns = @town_data.to_h.select { |_town, data| data['exchange'] }
    rooms = towns.map { |_town, data| data['exchange']['id'] }

    closest_id = sort_destinations_from_kiosk(rooms).first
    town_name, town = towns.find { |_town, data| data['exchange']['id'] == closest_id }

    {
      'town'     => town_name,
      'id'       => town['exchange']['id'],
      'fee'      => town['exchange']['fee'],
      'currency' => town['currency']
    }
  end

  # Special handling is required to ensure that we're using Kronars, even if our hometown uses another currency.
  # This logic will use the bank nearest to your kiosk to get your Kronars.
  def ensure_kronars_on_hand(target_amt)
    echo "ensure_kronars_on_hand: #{target_amt}" if @debug
    current_k = DRCM.check_wealth('Kronars')
    return true if current_k >= target_amt

    closest_bank = find_closest_bank
    echo "Closest bank: #{closest_bank}" if @debug

    if closest_bank['currency'] == 'kronars'
      echo "Using standard DRCM method" if @debug
      return DRCM.ensure_copper_on_hand(target_amt, @settings, closest_bank['town'])
    end

    needed = target_amt - current_k

    withdraw_amt_copper = DRCM.convert_currency(
      needed,
      closest_bank['currency'],
      'kronars',
      -closest_bank['fee']
    )

    # Extract platinum and lump the rest as copper to avoid conversion issues with small amounts, while minimizing burden
    platinum_amt = withdraw_amt_copper / 10000
    copper_amt = withdraw_amt_copper % 10000

    withdrawals = []
    withdrawals << "#{platinum_amt} platinum" if platinum_amt > 0
    withdrawals << "#{copper_amt} copper" if copper_amt > 0

    bank_town = closest_bank['town']
    success = withdrawals.all? do |amount_as_string|
      formatted_withdrawal = "#{amount_as_string} #{closest_bank['currency']}"
      DRCM.withdraw_exact_amount?(formatted_withdrawal, @settings, bank_town)
    end

    unless success
      DRC.message("Failed to withdraw required currency from the bank.")
      exit
    end

    DRCT.walk_to(closest_bank['id'])

    exchange_result = DRC.bput(
      "exchange all #{closest_bank['currency']} for Kronars",
      'After figuring a trivial fee',
      'The money-changer says',
      'After collecting a modest fee',
      "You don't have that many"
    )

    case exchange_result
    when "You don't have that many"
      DRC.message("You're out of money.")
      exit
    end
  end

  def refill_kiosk(on_hand)
    echo "refill_kiosk: #{on_hand}" if @debug
    return if on_hand >= @kiosk_settings['minimum_refill']

    refill_amount = @kiosk_settings['target_deposit'] - on_hand
    ensure_kronars_on_hand(refill_amount)

    DRCT.walk_to(@kiosk_room)
    @my_kiosk ||= identify_my_kiosk
    2.times do
      result = DRC.bput("poke #{@my_kiosk}", 'The tessera swiftly rearranges', 'pulses with soft light and chimes merrily', 'As you are not the owner of a')

      if result == "As you are not the owner of a"
        @my_kiosk = identify_my_kiosk(true)
        return refill_kiosk(on_hand)
      end
    end
  end

  def withdraw_kiosk(pouch_amount, bundle_amount)
    if @debug
      echo "withdraw_kiosk"
      echo "  pouch_amount: #{pouch_amount}"
      echo "  bundle_amount: #{bundle_amount}"
    end

    return unless pouch_amount >= @kiosk_settings['minimum_pouch_withdrawal'] ||
                  bundle_amount >= @kiosk_settings['minimum_bundle_withdrawal']

    DRCT.walk_to(@kiosk_room)
    @my_kiosk ||= identify_my_kiosk

    if pouch_amount >= @kiosk_settings['minimum_pouch_withdrawal']
      result = ''
      until result.include?('pouch')
        result = DRC.bput("rub #{@my_kiosk}", 'It is now set to pay out pouch sales', 'It is now set to pay out bundle sales', 'As you are not the owner of a')
        if result == "As you are not the owner of a"
          @my_kiosk = identify_my_kiosk(true)
          return withdraw_kiosk(pouch_amount, bundle_amount)
        end
      end

      pouch_amount = 0
      DRC.bput("tap #{@my_kiosk}", 'been processed and recorded to your tessera-ledger')
      DRCI.put_away_item?('gem pouch', @settings.full_pouch_container)
    end

    if bundle_amount >= @kiosk_settings['minimum_bundle_withdrawal']
      result = ''
      until result.include?('bundle')
        result = DRC.bput("rub #{@my_kiosk}", 'It is now set to pay out pouch sales', 'It is now set to pay out bundle sales', 'As you are not the owner of a')
        if result == "As you are not the owner of a"
          @my_kiosk = identify_my_kiosk(true)
          return withdraw_kiosk(pouch_amount, bundle_amount)
        end
      end
      DRC.bput("tap #{@my_kiosk}", 'been processed and recorded to your tessera-ledger')
      DRCI.put_away_item?('bundle', @settings.full_pouch_container)
    end
  end
end

before_dying do
  Flags.delete('kiosk-desc')
end

Kiosk.new
